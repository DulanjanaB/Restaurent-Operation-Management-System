# Copy this file to .env (same folder as docker-compose.yml) and fill in every value.
# Keep .env private — it contains passwords and the signing secret.

# Database (used by PostgreSQL and the backend)
DB_PASSWORD=change-me-to-a-strong-password

# Sign-in tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-string

# First administrator account, created on the first start only
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@your-restaurant.example
ADMIN_PASSWORD=change-me-to-a-strong-password

# Address that phones and staff use to reach the web app (printed into QR stickers).
APP_PUBLIC_URL=http://localhost:3000

# Keep true for a fresh install. After the first successful start on a live
# server, set it to false so the database structure is never changed automatically.
DB_SYNC=true
